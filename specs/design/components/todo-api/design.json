{
  "name": "todo-api",
  "type": "service",
  "version": "0.1.0",
  "language": "Ballerina",
  "buildpack": "docker",
  "appPath": "todo-api",
  "entrypoint": "deployment/service",
  "exposure": "internet",
  "stories": [
    2,
    3,
    4,
    5,
    6,
    7
  ],
  "description": "The backend for the todo app: exposes /me/todos to list, create, update and delete the signed-in caller's own todos, persisting them in its Postgres database. It never sees another user's todos and performs no cross-user aggregation.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "thunder",
      "description": "Verifies the gateway's signed assertion for every call and enforces the todos scopes.",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "todo-webapp-persi-44e77d06",
        "envBindings": {
          "client_id": "THUNDER_CLIENT_ID",
          "issuer": "THUNDER_ISSUER",
          "jwks_url": "THUNDER_JWKS_URL",
          "resource": "THUNDER_RESOURCE",
          "scopes": "THUNDER_SCOPES"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "todo-db",
      "description": "Persists each user's todo items across sessions and devices.",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "todo-webapp-persi-55b30b7d",
        "envBindings": {
          "dbname": "TODO_DB_DBNAME",
          "host": "TODO_DB_HOST",
          "password": "TODO_DB_PASSWORD",
          "port": "TODO_DB_PORT",
          "user": "TODO_DB_USER"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "api-management",
    "thunder-authentication"
  ]
}
