{
  "version": 3,
  "permissions": [
    {
      "resource": "todos",
      "component": "todo-api",
      "description": "A signed-in user's own todo items",
      "actions": [
        { "handle": "read", "description": "The caller's own todos" },
        { "handle": "create", "description": "Add a new todo" },
        { "handle": "update", "description": "Edit or complete/uncomplete a todo" },
        { "handle": "delete", "description": "Remove a todo" }
      ]
    }
  ],
  "groups": [
    { "name": "Users", "description": "Everyone who uses the todo app" }
  ],
  "roles": [
    {
      "name": "User",
      "description": "Signs in and manages their own private todo list.",
      "stories": [1, 2, 3, 4, 5, 6, 7],
      "grants": ["todos:read", "todos:create", "todos:update", "todos:delete"],
      "assignTo": ["Users"]
    }
  ],
  "testUsers": [
    { "username": "test-user", "roles": ["User"] }
  ]
}
